        skos:definition   "The geometric entity representing the interior of a concrete concept"@en;
        skos:prefLabel    "has interior"@en .

sml:Solid  rdf:type       sml:AggregationStateType;
        rdfs:comment      "Matter that can be picked up or held, having a texture, and usually firm. Unlike a liquid, gas or plasma"@en;
