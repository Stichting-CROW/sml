sml-term:aggregationStateType
        rdf:type          skos:Concept;
        rdfs:comment      "The possession of an aggregation state type"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "aggregation state type"@en;
        vs:term_status    "stable";
        skos:definition   "The possession of an aggregation state type"@en;
        skos:prefLabel    "aggregation state type"@en .

sml:State  rdf:type       rdfs:Class , owl:Class , sh:NodeShape;
        rdfs:comment      "Temporal part of an entity during a period between two events. A state is characterized by the properties and relations of the entity"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "State"@en;
        rdfs:seeAlso      sml-term:State;
        rdfs:subClassOf   sml:ConcreteConcept;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sml:State;
                            owl:onProperty     sml:hasPart
                          ];
        vs:term_status    "stable";
        skos:definition   "Temporal part of an entity during a period between two events. A state is characterized by the properties and relations of the entity"@en;
        skos:prefLabel    "State"@en;
        sh:property       [ sh:class  sml:State;
                            sh:path   sml:hasPart
                          ];
        sh:property       [ sh:class  sml:GeometricEntity;
                            sh:path   sml:hasInterior
                          ];
        sh:property       [ sh:class  sml:GeometricEntity;
                            sh:path   sml:hasBoundary
                          ];
        sh:property       [ sh:class  time:TemporalEntity;
                            sh:path   sml:hasPeriod
                          ] .

sml-term:isBoundBy  rdf:type  skos:Concept;
        rdfs:comment      "The physical object that bounds a spatial region"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "is bound by"@en;
        vs:term_status    "stable";
        skos:definition   "The physical object that bounds a spatial region"@en;
        skos:prefLabel    "is bound by"@en .

sml:TopConcept  rdf:type  rdfs:Class , owl:Class , sh:NodeShape;
        rdfs:comment      "The most generic concept"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Top concept"@en;
        rdfs:seeAlso      sml-term:TopConcept;
        vs:term_status    "stable";
        skos:definition   "The most generic concept"@en;
        skos:prefLabel    "Top concept"@en;
        sh:property       [ sh:class  sml:Requirement;
                            sh:path   sml:hasRequirement
                          ];
        sh:property       [ sh:datatype  xsd:string;
                            sh:path      sml:abbreviation
                          ];
        sh:property       [ sh:class  sml:InformationObject;
                            sh:path   sml:isDescribedBy
                          ] .

sml:Function  rdf:type    rdfs:Class , owl:Class;
        rdfs:comment      "An activity performed by an object whose external behavior contributes to goals set by one or more technical entities"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Function"@en;
        rdfs:subClassOf   sml:Activity , sml:FunctionalActivity;
        vs:term_status    "stable";
        skos:definition   "An activity performed by an object whose external behavior contributes to goals set by one or more technical entities"@en;
        skos:prefLabel    "Function"@en .

sml-term:RealObject  rdf:type  skos:Concept;
        rdfs:comment      "physical object (rigid or non-rigid) that is (or can be) tangible and visible in reality, man-made or naturally occurring"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Real object"@en;
        vs:term_status    "stable";
        skos:altLabel     "Amount of matter"@en;
        skos:broader      sml-term:PhysicalObject;
        skos:definition   "physical object (rigid or non-rigid) that is (or can be) tangible and visible in reality, man-made or naturally occurring"@en;
        skos:prefLabel    "Real object"@en .

sml-term:TransferType
        rdf:type          skos:Concept;
        rdfs:comment      "The type of thing being transferred, here: material, information, energy or force"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Transfer type"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:EnumerationType;
        skos:definition   "The type of thing being transferred, here: material, information, energy or force"@en;
        skos:prefLabel    "Transfer type"@en .

sml-term:PureSubstance
        rdf:type          skos:Concept;
        rdfs:comment      "Chemical matter that has an equal chemical composition and recognizable uniform and isotropic properties"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Pure substance"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:Matter;
        skos:definition   "Chemical matter that has an equal chemical composition and recognizable uniform and isotropic properties"@en;
        skos:prefLabel    "Pure substance"@en .

sml:overInterface  rdf:type  rdf:Property , owl:ObjectProperty;
        rdfs:comment      "The interface over which an interaction between physical objects takes place"@en;
        rdfs:domain       sml:Interaction;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "over interface"@en;
        rdfs:range        sml:Interface;
        rdfs:seeAlso      sml-term:overInterface;
        vs:term_status    "stable";
        skos:definition   "The interface over which an interaction between physical objects takes place"@en;
        skos:prefLabel    "over interface"@en .

sml-term:AmountOfBulkMatter
        rdf:type          skos:Concept;
        rdfs:comment      "A real object that consists of a continuous amount of non-rigid matter, held together primarily by external forces (gravity or confinement)"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Amount of bulk matter"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:RealObject;
        skos:definition   "A real object that consists of a continuous amount of non-rigid matter, held together primarily by external forces (gravity or confinement)"@en;
        skos:prefLabel    "Amount of bulk matter"@en .

sml-term:Activity  rdf:type  skos:Concept;
        rdfs:comment      "Entity that takes place or can take place in a concrete space-time. An activity transforms objects, and is executed by an object"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Activity"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:Entity;
        skos:definition   "Entity that takes place or can take place in a concrete space-time. An activity transforms objects, and is executed by an object"@en;
        skos:prefLabel    "Activity"@en .

sml:Mixture  rdf:type     owl:Class , rdfs:Class , sh:NodeShape;
        rdfs:comment      "The combination of two or more different pure substances without the molecules losing their identity"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Mixture"@en;
        rdfs:seeAlso      sml-term:Mixture;
        rdfs:subClassOf   sml:Matter;
        vs:term_status    "stable";
        skos:definition   "The combination of two or more different pure substances without the molecules losing their identity"@en;
        skos:prefLabel    "Mixture"@en;
        sh:property       [ sh:or    ( [ sh:class  sml:Matter ]
                                       [ sh:class  sml:MatterPortion ]
                                     );
                            sh:path  sml:consistsOf
                          ] .

sml-term:GeometricEntity
        rdf:type          skos:Concept;
        rdfs:comment      "Named concept, which forms an actual or virtual demarcation in a concrete (physical, three-dimensional) space, which we experience in reality"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Geometric entity"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:Representation;
        skos:definition   "Named concept, which forms an actual or virtual demarcation in a concrete (physical, three-dimensional) space, which we experience in reality"@en;
        skos:prefLabel    "Geometric entity"@en .

<https://w3id.org/sml/2/owl/def>
        rdf:type          owl:Ontology;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        owl:imports       <https://w3id.org/sml/2/rdfs/def> , <http://qudt.org/2.1/vocab/quantitykind> , <http://www.w3.org/2004/02/skos/core> , <http://www.opengis.net/ont/geosparql> , sosa: , <http://www.w3.org/2006/time> , <http://qudt.org/2.1/vocab/unit> , <http://www.w3.org/ns/shacl> , <https://w3id.org/sml/owl/def> , <http://qudt.org/2.1/schema/qudt>;
        vs:term_status    "stable" .

sml:Event  rdf:type       sh:NodeShape , rdfs:Class , owl:Class;
        rdfs:comment      "Transition between two successive states of an entity (object or activity). An event is triggered in a state"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Event"@en;
        rdfs:seeAlso      sml-term:Event;
        rdfs:subClassOf   sml:ConcreteConcept;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sml:Event;
                            owl:onProperty     sml:hasPart
                          ];
        vs:term_status    "stable";
        skos:definition   "Transition between two successive states of an entity (object or activity). An event is triggered in a state"@en;
        skos:prefLabel    "Event"@en;
        sh:property       [ sh:class  sml:State;
                            sh:path   sml:ends
                          ];
        sh:property       [ sh:class  sml:State;
                            sh:path   sml:begins
                          ];
        sh:property       [ sh:class  sml:Event;
                            sh:path   sml:hasPart
                          ] .

sml-term:connectsObject
        rdf:type          skos:Concept;
        rdfs:comment      "The physical objects connected by a connection or interface"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "connects object"@en;
        vs:term_status    "stable";
        skos:definition   "The physical objects connected by a connection or interface"@en;
        skos:prefLabel    "connects object"@en .

sml:AllDisjointClasses_4
        rdf:type          owl:AllDisjointClasses;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        owl:members       ( sml:RealObject sml:SpatialRegion );
        vs:term_status    "stable" .

sml:connectsPort  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:comment      "The ports (as part of physical objects) connected by a connection or interface"@en;
        rdfs:domain       [ rdf:type     owl:Class;
                            owl:unionOf  ( sml:Connection sml:Interface )
                          ];
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "connects port"@en;
        rdfs:range        sml:Port;
        rdfs:seeAlso      sml-term:connectsPort;
        vs:term_status    "stable";
        skos:definition   "The ports (as part of physical objects) connected by a connection or interface"@en;
        skos:prefLabel    "connects port"@en .

sml:requirementSourceType
        rdf:type          owl:ObjectProperty , rdf:Property;
        rdfs:comment      "The possession of a source type by a requirement"@en;
        rdfs:domain       sml:Requirement;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "requirement source type"@en;
        rdfs:range        sml:RequirementSourceType;
        rdfs:seeAlso      sml-term:requirementSourceType;
        vs:term_status    "stable";
        skos:definition   "The possession of a source type by a requirement"@en;
        skos:prefLabel    "requirement source type"@en .

sml:connectsObject  rdf:type  rdf:Property , owl:ObjectProperty;
        rdfs:comment      "The physical objects connected by a connection or interface"@en;
        rdfs:domain       [ rdf:type     owl:Class;
                            owl:unionOf  ( sml:Connection sml:Interface )
                          ];
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "connects object"@en;
        rdfs:range        sml:PhysicalObject;
        rdfs:seeAlso      sml-term:connectsObject;
        vs:term_status    "stable";
        skos:definition   "The physical objects connected by a connection or interface"@en;
        skos:prefLabel    "connects object"@en .

sml-term:ChemicalCompound
        rdf:type          skos:Concept;
        rdfs:comment      "Pure substance consisting of two or more chemical elements that have a chemical bond with each other. In a chemical compound, the elements occur in a fixed ratio. A compound can be broken down into simpler substances by means of chemical reactions"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Chemical compound"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:PureSubstance;
        skos:definition   "Pure substance consisting of two or more chemical elements that have a chemical bond with each other. In a chemical compound, the elements occur in a fixed ratio. A compound can be broken down into simpler substances by means of chemical reactions"@en;
        skos:prefLabel    "Chemical compound"@en .

sml:GeometricEntity  rdf:type  rdfs:Class , owl:Class;
        rdfs:comment      "Named concept, which forms an actual or virtual demarcation in a concrete (physical, three-dimensional) space, which we experience in reality"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Geometric entity"@en;
        rdfs:seeAlso      sml-term:GeometricEntity;
        rdfs:subClassOf   sml:Representation;
        vs:term_status    "stable";
        skos:definition   "Named concept, which forms an actual or virtual demarcation in a concrete (physical, three-dimensional) space, which we experience in reality"@en;
        skos:prefLabel    "Geometric entity"@en .

sml-term:requirementSeverityType
        rdf:type          skos:Concept;
        rdfs:comment      "The possession of a severity type by a requirement"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "requirement severity type"@en;
        vs:term_status    "stable";
        skos:definition   "The possession of a severity type by a requirement"@en;
        skos:prefLabel    "requirement severity type"@en .

<https://w3id.org/sml/owl/def>
        rdf:type          owl:Ontology;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        owl:imports       <http://qudt.org/2.1/schema/qudt> , <http://www.w3.org/2004/02/skos/core> , <https://w3id.org/sml/rdfs/def> , <http://www.w3.org/2006/time> , <http://www.w3.org/ns/shacl> , <http://qudt.org/2.1/vocab/quantitykind> , <http://qudt.org/2.1/vocab/unit>;
        vs:term_status    "stable" .

qudt:QuantityKind  rdf:type  sml:EnumerationType;
        rdfs:comment      "Any observable property that can be measured and quantified numerically"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Quantity kind"@en;
        rdfs:seeAlso      sml-term:QuantityKind;
        vs:term_status    "stable";
        skos:definition   "Any observable property that can be measured and quantified numerically"@en;
        skos:prefLabel    "Quantity kind"@en .

sml:AllDisjointClassesShape2
        rdf:type             sh:NodeShape;
        rdfs:isDefinedBy     <https://w3id.org/sml/>;
        vs:term_status       "stable";
        sh:property          [ sh:path                 ( rdf:type
                                                         [ sh:zeroOrMorePath  rdfs:subClassOf ]
                                                       );
                               sh:qualifiedMaxCount    1;
                               sh:qualifiedValueShape  [ sh:in   ( sml:RealObject sml:SpatialRegion )
                                                       ]
                             ];
        sh:targetSubjectsOf  rdf:type .

sml:ConceptType  rdf:type  owl:Class , rdfs:Class;
        rdfs:comment      "A meta-concept having concepts as instances that can have attributes or relations"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Concept type"@en;
        rdfs:seeAlso      sml-term:ConceptType;
        rdfs:subClassOf   sml:Type;
        vs:term_status    "stable";
        skos:definition   "A meta-concept having concepts as instances that can have attributes or relations"@en;
        skos:prefLabel    "Concept type"@en .

sml-term:Interaction  rdf:type  skos:Concept;
        rdfs:comment      "The activity being a combination of sub-activities performed by physical objects between which a transfer of matter, information, energy or force takes place, typically over a connection or interface (directly or through ports)"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Interaction"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:Activity;
        skos:definition   "The activity being a combination of sub-activities performed by physical objects between which a transfer of matter, information, energy or force takes place, typically over a connection or interface (directly or through ports)"@en;
        skos:prefLabel    "Interaction"@en .

sml-term:Mixture  rdf:type  skos:Concept;
        rdfs:comment      "The combination of two or more different pure substances without the molecules losing their identity"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Mixture"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:Matter;
        skos:definition   "The combination of two or more different pure substances without the molecules losing their identity"@en;
        skos:prefLabel    "Mixture"@en .

sml-term:overConnection
        rdf:type          skos:Concept;
        rdfs:comment      "The connection over which an interaction between physical objects takes place"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "over connection"@en;
        vs:term_status    "stable";
        skos:definition   "The connection over which an interaction between physical objects takes place"@en;
        skos:prefLabel    "over connection"@en .

<https://w3id.org/sml/2/rdfs/def>
        rdf:type          owl:Ontology;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        owl:imports       <https://w3id.org/sml/rdfs/def> , <http://www.w3.org/2003/01/geo/wgs84_pos> , <http://qudt.org/2.1/schema/qudt> , <http://www.w3.org/ns/shacl> , <http://qudt.org/2.1/vocab/unit> , <http://www.w3.org/2006/time> , <http://www.opengis.net/ont/geosparql> , sosa: , <http://www.w3.org/2004/02/skos/core> , <http://qudt.org/2.1/vocab/quantitykind> , <https://w3id.org/sml/2/skos/term>;
        vs:term_status    "stable" .

sml:overConnection  rdf:type  rdf:Property , owl:ObjectProperty;
        rdfs:comment      "The connection over which an interaction between physical objects takes place"@en;
        rdfs:domain       sml:Interaction;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "over connection"@en;
        rdfs:range        sml:Connection;
        rdfs:seeAlso      sml-term:overConnection;
        vs:term_status    "stable";
        skos:definition   "The connection over which an interaction between physical objects takes place"@en;
        skos:prefLabel    "over connection"@en .

sml:contains  rdf:type    rdf:Property , owl:ObjectProperty;
        rdfs:comment      "The real objects located in a spatial region, typically the gaseous amount of bulk matter present in that region"@en;
        rdfs:domain       sml:SpatialRegion;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "contains"@en;
        rdfs:range        sml:RealObject;
        rdfs:seeAlso      sml-term:contains;
        vs:term_status    "stable";
        skos:definition   "The real objects located in a spatial region, typically the gaseous amount of bulk matter present in that region"@en;
        skos:prefLabel    "contains"@en .

sml-term:triggers  rdf:type  skos:Concept;
        rdfs:comment      "The event triggert by an entity"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "triggers"@en;
        vs:term_status    "stable";
        skos:definition   "The event triggert by an entity"@en;
        skos:prefLabel    "triggers"@en .

sml-term:isConnectedTo
        rdf:type          skos:Concept;
        rdfs:comment      "The topological relation between physical objects"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "is connected to"@en;
        vs:term_status    "stable";
        skos:definition   "The topological relation between physical objects"@en;
        skos:prefLabel    "is connected to"@en .

sml-term:Solid  rdf:type  skos:Concept;
        rdfs:comment      "Matter that can be picked up or held, having a texture, and usually firm. Unlike a liquid, gas or plasma"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Solid"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:AggregationStateType;
        skos:definition   "Matter that can be picked up or held, having a texture, and usually firm. Unlike a liquid, gas or plasma"@en;
        skos:prefLabel    "Solid"@en .

sml-term:participatesIn
        rdf:type          skos:Concept;
        rdfs:comment      "The interaction a physical object participates in"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "participates in"@en;
        vs:term_status    "stable";
        skos:definition   "The interaction a physical object participates in"@en;
        skos:prefLabel    "participates in"@en .

<https://w3id.org/sml/skos/term>
        rdf:type            skos:ConceptScheme;
        rdfs:isDefinedBy    <https://w3id.org/sml/>;
        owl:imports         <http://www.w3.org/2004/02/skos/core> , <http://www.w3.org/2006/time> , <http://qudt.org/2.1/vocab/unit> , <http://www.w3.org/ns/shacl> , <http://qudt.org/2.1/vocab/quantitykind> , <http://qudt.org/2.1/schema/qudt>;
        vs:term_status      "stable";
        skos:hasTopConcept  sml-term:TopConcept .

sml:Entity  rdf:type      rdfs:Class , sh:NodeShape , owl:Class;
        rdfs:comment      "Concept that forms a manifestation and a demarcation in a concrete space-time, and which has a certain state at any moment in time. An entity has a unique identity that remains constant throughout its life cycle. The life cycle of an entity is made up of the sequence of states of that entity, which follow each other in time. An entity is an object or an activity. An object exists, an activity takes place"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Entity"@en;
        rdfs:seeAlso      sml-term:Entity;
        rdfs:subClassOf   sml:ConcreteConcept;
        vs:term_status    "stable";
        skos:definition   "Concept that forms a manifestation and a demarcation in a concrete space-time, and which has a certain state at any moment in time. An entity has a unique identity that remains constant throughout its life cycle. The life cycle of an entity is made up of the sequence of states of that entity, which follow each other in time. An entity is an object or an activity. An object exists, an activity takes place"@en;
        skos:prefLabel    "Entity"@en;
        sh:property       [ sh:class  sml:State;
                            sh:path   sml:hasState
                          ];
        sh:property       [ sh:class  sml:Event;
                            sh:path   sml:triggers
                          ] .

sml:participatesIn  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:comment      "The interaction a physical object participates in"@en;
        rdfs:domain       sml:PhysicalObject;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "participates in"@en;
        rdfs:range        sml:Interaction;
        rdfs:seeAlso      sml-term:participatesIn;
        vs:term_status    "stable";
        skos:definition   "The interaction a physical object participates in"@en;
        skos:prefLabel    "participates in"@en .

sml-term:TechnicalEntity
        rdf:type          skos:Concept;
        rdfs:comment      "An entity concerned with technical properties and relations that implements or plays functional entities"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Technical entity"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:Entity;
        skos:definition   "An entity concerned with technical properties and relations that implements or plays functional entities"@en;
        skos:prefLabel    "Technical entity"@en .

sml-term:hasQuantityKind
        rdf:type          skos:Concept;
        rdfs:comment      "The possession of a quantity kind"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "has quantity kind"@en;
        vs:term_status    "stable";
        skos:definition   "The possession of a quantity kind"@en;
        skos:prefLabel    "has quantity kind"@en .

sml:TechnicalEntity  rdf:type  sh:NodeShape , rdfs:Class;
        rdfs:comment      "An entity concerned with technical properties and relations that implements or plays functional entities"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Technical entity"@en;
        rdfs:seeAlso      sml-term:TechnicalEntity;
