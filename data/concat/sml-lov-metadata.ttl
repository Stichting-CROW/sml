@prefix cc:           <http://creativecommons.org/ns#> .
@prefix dc:           <http://purl.org/dc/terms/> .
@prefix fn:           <http://www.w3.org/2005/xpath-functions#> .
@prefix foaf:         <http://xmlns.com/foaf/0.1/> .
@prefix ns:           <https://www.cencenelec.eu.nl/> .
@prefix owl:          <http://www.w3.org/2002/07/owl#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt:         <http://qudt.org/schema/qudt/> .
@prefix rdf:          <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdf4j:        <http://rdf4j.org/schema/rdf4j#> .
@prefix rdfs:         <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sesame:       <http://www.openrdf.org/schema/sesame#> .
@prefix sh:           <http://www.w3.org/ns/shacl#> .
@prefix skos:         <http://www.w3.org/2004/02/skos/core#> .
@prefix sml:          <https://w3id.org/sml/def#> .
@prefix sml-term:     <https://w3id.org/sml/term#> .
@prefix sosa:         <http://www.w3.org/ns/sosa/> .
@prefix time:         <http://www.w3.org/2006/time#> .
@prefix vann:         <http://purl.org/vocab/vann/> .
@prefix voaf:         <http://purl.org/vocommons/voaf#> .
@prefix vs:           <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix xsd:          <http://www.w3.org/2001/XMLSchema#> .

sml-term:Interface  rdf:type  skos:Concept;
        rdfs:comment      "A spatial object, typically a thin 2D physical space (but also 0D or 1D) that connects two physical objects or ports of physical objects through which a static or dynamic interaction or interaction between those elements can take place"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Interface"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:SpatialRegion;
        skos:definition   "A spatial object, typically a thin 2D physical space (but also 0D or 1D) that connects two physical objects or ports of physical objects through which a static or dynamic interaction or interaction between those elements can take place"@en;
        skos:prefLabel    "Interface"@en .

sml-term:ConcreteConcept
        rdf:type          skos:Concept;
        rdfs:comment      "Concept that forms a manifestation and a demarcation in a concrete space-time. A concrete concept has a life cycle"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Concrete concept"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:TopConcept;
        skos:definition   "Concept that forms a manifestation and a demarcation in a concrete space-time. A concrete concept has a life cycle"@en;
        skos:prefLabel    "Concrete concept"@en .

sml-term:EnumerationType
        rdf:type          skos:Concept;
        rdfs:comment      "A meta-concept having concepts as instances having no further attributes or relations (annotations only)"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Enumeration type"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:Type;
        skos:definition   "A meta-concept having concepts as instances having no further attributes or relations (annotations only)"@en;
        skos:prefLabel    "Enumeration type"@en .

sml-term:isPlanFor  rdf:type  skos:Concept;
        rdfs:comment      "A potentially realized entity according to this planned entity"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "is plan for"@en;
        vs:term_status    "stable";
        skos:definition   "A potentially realized entity according to this planned entity"@en;
        skos:prefLabel    "is plan for"@en .

sml:isImplementedBy  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:comment        "The technical entity that implements a functional entity"@en;
        rdfs:domain         sml:FunctionalEntity;
        rdfs:isDefinedBy    <https://w3id.org/sml/>;
        rdfs:label          "is implemented by"@en;
        rdfs:range          sml:TechnicalEntity;
        rdfs:seeAlso        sml-term:isImplementedBy;
        rdfs:subPropertyOf  sml:hasSolution;
        vs:term_status      "stable";
        skos:definition     "The technical entity that implements a functional entity"@en;
        skos:prefLabel      "is implemented by"@en .

sml-term:AggregationStateType
        rdf:type          skos:Concept;
        rdfs:comment      "One of the four fundamental states of matter being a solid, liquid, gas or plasma"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Aggregation state type"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:EnumerationType;
        skos:definition   "One of the four fundamental states of matter being a solid, liquid, gas or plasma"@en;
        skos:prefLabel    "Aggregation state type"@en .

sml:portion  rdf:type        owl:ObjectProperty , rdf:Property;
        rdfs:comment         "The relative portion of a matter portion"@en;
        rdfs:domain          sml:MatterPortion;
        rdfs:isDefinedBy     <https://w3id.org/sml/>;
        rdfs:label           "portion"@en;
        rdfs:range           sml:QuantityValue;
        rdfs:seeAlso         sml-term:portion;
        vs:term_status       "stable";
        skos:definition      "The relative portion of a matter portion"@en;
        skos:prefLabel       "portion"@en;
        sml:hasQuantityKind  quantitykind:DimensionlessRatio .

sml:hasQuantityKindShape
        rdf:type            sh:NodeShape;
        rdfs:isDefinedBy    <https://w3id.org/sml/>;
        vs:term_status      "stable";
        sh:class            qudt:QuantityKind;
        sh:targetObjectsOf  sml:hasQuantityKind .

sml:ConcreteConcept  rdf:type  sh:NodeShape , owl:Class , rdfs:Class;
        rdfs:comment      "Concept that forms a manifestation and a demarcation in a concrete space-time. A concrete concept has a life cycle"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Concrete concept"@en;
        rdfs:seeAlso      sml-term:ConcreteConcept;
        rdfs:subClassOf   sml:TopConcept;
        vs:term_status    "stable";
        skos:definition   "Concept that forms a manifestation and a demarcation in a concrete space-time. A concrete concept has a life cycle"@en;
        skos:prefLabel    "Concrete concept"@en;
        sh:property       [ sh:class  sml:GeometricEntity;
                            sh:path   sml:hasInterior
                          ];
        sh:property       [ sh:class  rdfs:Container;
                            sh:path   sml:hasPartsGroup
                          ];
        sh:property       [ sh:class  time:TemporalEntity;
                            sh:path   sml:hasTemporalEntity
                          ];
        sh:property       [ sh:class  sml:GeometricEntity;
                            sh:path   sml:hasBoundary
                          ];
        sh:property       [ sh:class  sml:ConcreteConcept;
                            sh:path   sml:hasPart
                          ] .

sml:EnumerationType  rdf:type  rdfs:Class , owl:Class;
        rdfs:comment      "A meta-concept having concepts as instances having no further attributes or relations (annotations only)"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Enumeration type"@en;
        rdfs:seeAlso      sml-term:EnumerationType;
        rdfs:subClassOf   rdfs:Container , sml:Type;
        vs:term_status    "stable";
        skos:definition   "A meta-concept having concepts as instances having no further attributes or relations (annotations only)"@en;
        skos:prefLabel    "Enumeration type"@en .

sml-term:Entity  rdf:type  skos:Concept;
        rdfs:comment      "Concept that forms a manifestation and a demarcation in a concrete space-time, and which has a certain state at any moment in time. An entity has a unique identity that remains constant throughout its life cycle. The life cycle of an entity is made up of the sequence of states of that entity, which follow each other in time. An entity is an object or an activity. An object exists, an activity takes place"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Entity"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:ConcreteConcept;
        skos:definition   "Concept that forms a manifestation and a demarcation in a concrete space-time, and which has a certain state at any moment in time. An entity has a unique identity that remains constant throughout its life cycle. The life cycle of an entity is made up of the sequence of states of that entity, which follow each other in time. An entity is an object or an activity. An object exists, an activity takes place"@en;
        skos:prefLabel    "Entity"@en .

<https://www.crow.nl>
        rdf:type    foaf:Organization;
        rdfs:label  "Stichting CROW"@nl .

sml-term:ConceptType  rdf:type  skos:Concept;
        rdfs:comment      "A meta-concept having concepts as instances that can have attributes or relations"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Concept type"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:Type;
        skos:definition   "A meta-concept having concepts as instances that can have attributes or relations"@en;
        skos:prefLabel    "Concept type"@en .

sml-term:PhysicalObject
        rdf:type          skos:Concept;
        rdfs:comment      "Object that exists or may exist within physical 4D space-time. A physical object forms a manifestation and a demarcation of matter and/or energy, and is (in)directly perceptible by the senses"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Physical object"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:Object;
        skos:definition   "Object that exists or may exist within physical 4D space-time. A physical object forms a manifestation and a demarcation of matter and/or energy, and is (in)directly perceptible by the senses"@en;
        skos:prefLabel    "Physical object"@en .

sml:AllDisjointClasses_2
        rdf:type          owl:AllDisjointClasses;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        owl:members       ( sml:FunctionalEntity sml:TechnicalEntity );
        vs:term_status    "stable" .

sml:PhysicalObject  rdf:type  rdfs:Class , owl:Class , sh:NodeShape;
        rdfs:comment      "Object that exists or may exist within physical 4D space-time. A physical object forms a manifestation and a demarcation of matter and/or energy, and is (in)directly perceptible by the senses"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Physical object"@en;
        rdfs:seeAlso      sml-term:PhysicalObject;
        rdfs:subClassOf   sml:Object;
        vs:term_status    "stable";
        skos:definition   "Object that exists or may exist within physical 4D space-time. A physical object forms a manifestation and a demarcation of matter and/or energy, and is (in)directly perceptible by the senses"@en;
        skos:prefLabel    "Physical object"@en;
        sh:property       [ sh:class  sml:Activity;
                            sh:path   sml:executes
                          ];
        sh:property       [ sh:class  sml:PhysicalObject;
                            sh:path   sml:isConnectedTo
                          ];
        sh:property       [ sh:class  sml:InformationObject;
                            sh:path   sml:isDescribedBy
                          ];
        sh:property       [ sh:class  sml:Interaction;
                            sh:path   sml:participatesIn
                          ] .

sml:Liquid  rdf:type      sml:AggregationStateType;
        rdfs:comment      "A liquid is a nearly incompressible fluid that conforms to the shape of its container but retains a (nearly) constant volume independent of pressure"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Liquid"@en;
        rdfs:seeAlso      sml-term:Liquid;
        vs:term_status    "stable";
        skos:definition   "A liquid is a nearly incompressible fluid that conforms to the shape of its container but retains a (nearly) constant volume independent of pressure"@en;
        skos:prefLabel    "Liquid"@en .

sml-term:abbreviation
        rdf:type          skos:Concept;
        rdfs:comment      "Acronym or initial word as special case of a name"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "abbreviation"@en;
        vs:term_status    "stable";
        skos:broader      skos:altLabel;
        skos:definition   "Acronym or initial word as special case of a name"@en;
        skos:prefLabel    "abbreviation"@en .

sml-term:portion  rdf:type  skos:Concept;
        rdfs:comment      "The relative portion of a matter portion"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "portion"@en;
        vs:term_status    "stable";
        skos:definition   "The relative portion of a matter portion"@en;
        skos:prefLabel    "portion"@en .

sml:triggers  rdf:type    rdf:Property , owl:ObjectProperty;
        rdfs:comment      "The event triggert by an entity"@en;
        rdfs:domain       sml:Entity;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "triggers"@en;
        rdfs:range        sml:Event;
        rdfs:seeAlso      sml-term:triggers;
        vs:term_status    "stable";
        skos:definition   "The event triggert by an entity"@en;
        skos:prefLabel    "triggers"@en .

sml:isConnectedTo  rdf:type  rdf:Property , owl:ObjectProperty;
        rdfs:comment      "The topological relationship between physical objects"@en;
        rdfs:domain       sml:PhysicalObject;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "is connected to"@en;
        rdfs:range        sml:PhysicalObject;
        rdfs:seeAlso      sml-term:isConnectedTo;
        vs:term_status    "stable";
        skos:definition   "The topological relationship between physical objects"@en;
        skos:prefLabel    "is connected to"@en .

sml-term:HomogeneousMixture
        rdf:type          skos:Concept;
        rdfs:comment      "A mixture that is uniform throughout, and has only one phase"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Homogeneous mixture"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:Mixture;
        skos:definition   "A mixture that is uniform throughout, and has only one phase"@en;
        skos:prefLabel    "Homogeneous mixture"@en .

sml:begins  rdf:type      rdf:Property , owl:ObjectProperty;
        rdfs:comment      "The state that is started by an event"@en;
        rdfs:domain       sml:Event;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "begins"@en;
        rdfs:range        sml:State;
        rdfs:seeAlso      sml-term:begins;
        vs:term_status    "stable";
        skos:definition   "The state that is started by an event"@en;
        skos:prefLabel    "begins"@en .

sml:Object  rdf:type      owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:comment      "Entity that exists or can exist within a concrete space-time. An object executes an activity, and is transformed by an activity"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Object"@en;
        rdfs:seeAlso      sml-term:Object;
        rdfs:subClassOf   sml:Entity;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sml:Object;
                            owl:onProperty     sml:hasPart
                          ];
        vs:term_status    "stable";
        skos:definition   "Entity that exists or can exist within a concrete space-time. An object executes an activity, and is transformed by an activity"@en;
        skos:prefLabel    "Object"@en;
        sh:property       [ sh:class  sml:Object;
                            sh:path   sml:hasPart
                          ] .

sml:MaterialFlow  rdf:type  sml:TransferType;
        rdfs:comment      "The movement of an amount of material"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Material flow"@en;
        rdfs:seeAlso      sml-term:MaterialFlow;
        vs:term_status    "stable";
        skos:definition   "The movement of an amount of material"@en;
        skos:prefLabel    "Material flow"@en .

sml:RelationReference
        rdf:type          sh:NodeShape , rdfs:Class , owl:Class;
        rdfs:comment      "The objectification of a reference for a relation having a complex value like a simple reference sec combined with other metadata or just a combination of simple references (n-ary relation)"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Relation reference"@en;
        rdfs:seeAlso      sml-term:RelationReference;
        rdfs:subClassOf   sml:Objectification;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  xsd:anyURI;
                            owl:onProperty     rdf:value
                          ];
        vs:term_status    "stable";
        skos:definition   "The objectification of a reference for a relation having a complex value like a simple reference sec combined with other metadata or just a combination of simple references (n-ary relation)"@en;
        skos:prefLabel    "Relation reference"@en;
        sh:property       [ sh:datatype  xsd:anyURI;
                            sh:path      rdf:value
                          ] .

sml:ChemicalCompound  rdf:type  rdfs:Class , owl:Class;
        rdfs:comment      "Pure substance consisting of two or more chemical elements that have a chemical bond with each other. In a chemical compound, the elements occur in a fixed ratio. A compound can be broken down into simpler substances by means of chemical reactions"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Chemical compound"@en;
        rdfs:seeAlso      sml-term:ChemicalBonding;
        rdfs:subClassOf   sml:PureSubstance;
        vs:term_status    "stable";
        skos:definition   "Pure substance consisting of two or more chemical elements that have a chemical bond with each other. In a chemical compound, the elements occur in a fixed ratio. A compound can be broken down into simpler substances by means of chemical reactions"@en;
        skos:prefLabel    "Chemical compound"@en .

sml:hasUnitShape  rdf:type  sh:NodeShape;
        rdfs:isDefinedBy    <https://w3id.org/sml/>;
        vs:term_status      "stable";
        sh:class            qudt:Unit;
        sh:targetObjectsOf  sml:hasUnit .

sml:RequirementSeverityType
        rdf:type          owl:Class , sml:EnumerationType , rdfs:Class;
        rdfs:comment      "The seriousness of a requirement like demanded or wished"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Requirement severity type"@en;
        rdfs:seeAlso      sml-term:RequirementSeverityType;
        vs:term_status    "stable";
        skos:definition   "The seriousness of a requirement like demanded or wished"@en;
        skos:prefLabel    "Requirement severity type"@en .

sml-term:RealizedEntity
        rdf:type          skos:Concept;
        rdfs:comment      "An entity that exists or has existed in the physical reality"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Realized entity"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:Entity;
        skos:definition   "An entity that exists or has existed in the physical reality"@en;
        skos:prefLabel    "Realized entity"@en .

sml-term:isDescribedBy
        rdf:type          skos:Concept;
        rdfs:comment      "The information object that describes something"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "is described by"@en;
        vs:term_status    "stable";
        skos:definition   "The information object that describes something"@en;
        skos:prefLabel    "is described by"@en .

sml:Requirement  rdf:type  rdfs:Class , owl:Class , sh:NodeShape;
        rdfs:comment      "A rule that should hold for something, defined via its attributes or relations";
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Requirement"@en;
        rdfs:seeAlso      sml-term:Requirement;
        rdfs:subClassOf   sml:InformationObject;
        rdfs:subClassOf   [ rdf:type                  owl:Restriction;
                            owl:onClass               xsd:string;
                            owl:onProperty            rdf:value;
                            owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                          ];
        vs:term_status    "stable";
        skos:definition   "A rule that should hold for something, defined via its attributes or relations";
        skos:prefLabel    "Requirement"@en;
        sh:property       [ sh:class  sml:RequirementTopicType;
                            sh:path   sml:requirementTopicType
                          ];
        sh:property       [ sh:class  sml:RequirementSeverityType;
                            sh:path   sml:requirementSeverityType
                          ];
        sh:property       [ sh:class  sml:RequirementSourceType;
                            sh:path   sml:requirementSourceType
                          ];
        sh:property       [ sh:datatype  xsd:string;
                            sh:maxCount  1;
                            sh:minCount  1;
                            sh:path      rdf:value
                          ] .

sml-term:Connection  rdf:type  skos:Concept;
        rdfs:comment      "A physical object (real object or spatial area) that connects two other physical objects and over which interaction takes place, namely the transfer of matter, energy, information or forces"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Connection"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:PhysicalObject;
        skos:definition   "A physical object (real object or spatial area) that connects two other physical objects and over which interaction takes place, namely the transfer of matter, energy, information or forces"@en;
        skos:prefLabel    "Connection"@en .

sml:consistsOf  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:comment      "The matter a real object or mixture is made of"@en;
        rdfs:domain       [ rdf:type     owl:Class;
                            owl:unionOf  ( sml:RealObject sml:Mixture )
                          ];
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "consists of"@en;
        rdfs:range        [ rdf:type     owl:Class;
                            owl:unionOf  ( sml:Matter sml:MatterPortion )
                          ];
        rdfs:seeAlso      sml-term:consistsOf;
        vs:term_status    "stable";
        skos:definition   "The matter a real object or mixture is made of"@en;
        skos:prefLabel    "consists of"@en .

time:TemporalEntity  rdfs:seeAlso  sml-term:TemporalEntity;
        rdfs:subClassOf  sml:Representation;
        skos:definition  "A temporal interval or instant"@en;
        skos:prefLabel   "Temporal entity"@en .

sml-term:AbstractConcept
        rdf:type          skos:Concept;
        rdfs:comment      "Concept that forms a manifestation and demarcation in an abstract space. An abstract concept has no life cycle"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Abstract concept"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:TopConcept;
        skos:definition   "Concept that forms a manifestation and demarcation in an abstract space. An abstract concept has no life cycle"@en;
        skos:prefLabel    "Abstract concept"@en .

<https://w3id.org/sml/shacl/def>
        rdf:type          owl:Ontology;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        owl:imports       <http://www.w3.org/ns/shacl> , <http://qudt.org/2.1/schema/qudt> , <http://www.w3.org/2004/02/skos/core> , <http://www.w3.org/2006/time> , <http://qudt.org/2.1/vocab/quantitykind> , <http://qudt.org/2.1/vocab/unit> , <https://w3id.org/sml/rdfs/def>;
        vs:term_status    "stable" .

sml-term:RequirementSourceType
        rdf:type          skos:Concept;
        rdfs:comment      "The type of source from which a requirement comes like a client, by definition, recommended by the sector or demanded by law/regulation"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Requirement source type"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:EnumerationType;
        skos:definition   "The type of source from which a requirement comes like a client, by definition, recommended by the sector or demanded by law/regulation"@en;
        skos:prefLabel    "Requirement source type"@en .

sml:isDescribedBy  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:comment      "The information object that describes something"@en;
        rdfs:domain       sml:TopConcept;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "is described by"@en;
        rdfs:range        sml:InformationObject;
        rdfs:seeAlso      sml-term:isDescribedBy;
        vs:term_status    "stable";
        skos:definition   "The information object that describes something"@en;
        skos:prefLabel    "is described by"@en .

sml-term:requirementTopicType
        rdf:type          skos:Concept;
        rdfs:comment      "The possession of a topic type by a requirement"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "requirement topic type"@en;
        vs:term_status    "stable";
        skos:definition   "The possession of a topic type by a requirement"@en;
        skos:prefLabel    "requirement topic type"@en .

sml:AbstractConcept  rdf:type  rdfs:Class , owl:Class;
        rdfs:comment      "Concept that forms a manifestation and demarcation in an abstract space. An abstract concept has no life cycle"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Abstract concept"@en;
        rdfs:seeAlso      sml-term:AbstractConcept;
        rdfs:subClassOf   sml:TopConcept;
        vs:term_status    "stable";
        skos:definition   "Concept that forms a manifestation and demarcation in an abstract space. An abstract concept has no life cycle"@en;
        skos:prefLabel    "Abstract concept"@en .

sml-term:hasTechnicalPart
        rdf:type          skos:Concept;
        rdfs:comment      "A hasPart relation of a technical nature"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "has technical part"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:hasPart;
        skos:definition   "A hasPart relation of a technical nature"@en;
        skos:prefLabel    "has technical part"@en .

sml-term:InformationObject
        rdf:type          skos:Concept;
        rdfs:comment      "Object which describes a thing in reality"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Information object"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:Object;
        skos:definition   "Object which describes a thing in reality"@en;
        skos:prefLabel    "Information object"@en .

sml:hasRequirement  rdf:type  rdf:Property , owl:ObjectProperty;
        rdfs:comment      "The (unstructured) requirement for something"@en;
        rdfs:domain       sml:TopConcept;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "has requirement"@en;
        rdfs:range        sml:Requirement;
        rdfs:seeAlso      sml-term:hasRequirement;
        vs:term_status    "stable";
        skos:definition   "The (unstructured) requirement for something"@en;
        skos:prefLabel    "has requirement"@en .

sml-term:hasInterior  rdf:type  skos:Concept;
        rdfs:comment      "The geometric entity representing the interior of a concrete concept"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "has interior"@en;
        vs:term_status    "stable";
        skos:definition   "The geometric entity representing the interior of a concrete concept"@en;
        skos:prefLabel    "has interior"@en .

sml-term:Objectification
        rdf:type          skos:Concept;
        rdfs:comment      "An attribute (quality or quantity) or relation represented as an individual defined by a concept"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Objectification"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:AbstractConcept;
        skos:definition   "An attribute (quality or quantity) or relation represented as an individual defined by a concept"@en;
        skos:prefLabel    "Objectification"@en .

sml-term:Requirement  rdf:type  skos:Concept;
        rdfs:comment      "A rule that should hold for something, defined via its attributes or relations"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Requirement"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:InformationObject;
        skos:definition   "A rule that should hold for something, defined via its attributes or relations"@en;
        skos:prefLabel    "Requirement"@en .

sml:AllDisjointClasses_1
        rdf:type          owl:AllDisjointClasses;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        owl:members       ( sml:PhysicalObject sml:InformationObject sml:Activity sml:Event sml:State );
        vs:term_status    "stable" .

sml:Objectification  rdf:type  owl:Class , rdfs:Class , sh:NodeShape;
        rdfs:comment      "An attribute (quality or quantity) or relation represented as an individual defined by a concept"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Objectification"@en;
        rdfs:seeAlso      sml-term:Objectification;
        rdfs:subClassOf   sml:AbstractConcept;
        rdfs:subClassOf   [ rdf:type            owl:Restriction;
                            owl:maxCardinality  "1"^^xsd:nonNegativeInteger;
                            owl:onProperty      rdf:value
                          ];
        vs:term_status    "stable";
        skos:definition   "An attribute (quality or quantity) or relation represented as an individual defined by a concept"@en;
        skos:prefLabel    "Objectification"@en;
        sh:property       [ sh:maxCount  1;
                            sh:path      rdf:value
                          ] .

sml-term:transferType
        rdf:type          skos:Concept;
        rdfs:comment      "The possession of a transfer type by an interaction"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "transfer type"@en;
        vs:term_status    "stable";
        skos:definition   "The possession of a transfer type by an interaction"@en;
        skos:prefLabel    "transfer type"@en .

sml-term:QuantityValue
        rdf:type          skos:Concept;
        rdfs:comment      "The objectification of a value of a quantity (typically involving a quantity kind and a unit) having a complex value like a simple value sec combined with other metadata or just a combination of simple values"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Quantity value"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:Objectification;
        skos:definition   "The objectification of a value of a quantity (typically involving a quantity kind and a unit) having a complex value like a simple value sec combined with other metadata or just a combination of simple values"@en;
        skos:prefLabel    "Quantity value"@en .

sml:hasPartsGroup  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:comment      "The possession of an group of, potentially implicit, parts"@en;
        rdfs:domain       sml:ConcreteConcept;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "has parts group"@en;
        rdfs:range        rdfs:Container;
        rdfs:seeAlso      sml-term:hasPart;
        vs:term_status    "stable";
        skos:definition   "The possession of an group of, potentially implicit, parts"@en;
        skos:prefLabel    "has parts group"@en .

sml-term:Force  rdf:type  skos:Concept;
        rdfs:comment      "Physical quantity which, when exerted on a body, causes tension or pressure to arise therein, or which causes the body to change motion, accelerate"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Force"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:TransferType;
        skos:definition   "Physical quantity which, when exerted on a body, causes tension or pressure to arise therein, or which causes the body to change motion, accelerate"@en;
        skos:prefLabel    "Force"@en .

sml:transferType  rdf:type  owl:ObjectProperty , rdf:Property;
        rdfs:comment      "The possession of a transfer type by an interaction"@en;
        rdfs:domain       sml:Interaction;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "transfer type"@en;
        rdfs:range        sml:TransferType;
        rdfs:seeAlso      sml-term:transferType;
        vs:term_status    "stable";
        skos:definition   "The possession of a transfer type by an interaction"@en;
        skos:prefLabel    "transfer type"@en .

sml:MatterPortion  rdf:type  owl:Class , rdfs:Class , sh:NodeShape;
        rdfs:comment      "An objectified relation reference for the consists of relation"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Matter portion"@en;
        rdfs:seeAlso      sml-term:MatterPortion;
        rdfs:subClassOf   sml:RelationReference;
        rdfs:subClassOf   [ rdf:type                  owl:Restriction;
                            owl:onClass               sml:Matter;
                            owl:onProperty            rdf:value;
                            owl:qualifiedCardinality  "1"^^xsd:nonNegativeInteger
                          ];
        rdfs:subClassOf   [ rdf:type         owl:Restriction;
                            owl:cardinality  "1"^^xsd:nonNegativeInteger;
                            owl:onProperty   sml:portion
                          ];
        vs:term_status    "stable";
        skos:definition   "An objectified relation reference for the consists of relation"@en;
        skos:prefLabel    "Matter portion"@en;
        sh:property       [ sh:class     sml:QuantityValue;
                            sh:maxCount  1;
                            sh:minCount  1;
                            sh:path      sml:portion
                          ] .

sml:AggregationStateType
        rdf:type          owl:Class , sml:EnumerationType , rdfs:Class , sh:NodeShape;
        rdfs:comment      "One of the four fundamental states of matter being a solid, liquid, gas or plasma"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Aggregation state type"@en;
        rdfs:seeAlso      sml-term:AggregationStateType;
        owl:oneOf         ( sml:Solid sml:Liquid sml:Gas sml:Plasma );
        vs:term_status    "stable";
        skos:definition   "One of the four fundamental states of matter being a solid, liquid, gas or plasma"@en;
        skos:prefLabel    "Aggregation state type"@en;
        sh:in             ( sml:Solid sml:Liquid sml:Gas sml:Plasma ) .

sml:hasBoundary  rdf:type  rdf:Property , owl:ObjectProperty;
        rdfs:comment      "The geometric entity representing the boundary of a concrete concept"@en;
        rdfs:domain       sml:ConcreteConcept;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "has boundary"@en;
        rdfs:range        sml:GeometricEntity;
        rdfs:seeAlso      sml-term:hasBoundary;
        vs:term_status    "stable";
        skos:definition   "The geometric entity representing the boundary of a concrete concept"@en;
        skos:prefLabel    "has boundary"@en .

sml-term:ChemicalElement
        rdf:type          skos:Concept;
        rdfs:comment      "Pure substance that is made up of atoms with the same atomic number. A chemical element cannot be decomposed through chemical reactions"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Chemical element"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:PureSubstance;
        skos:definition   "Pure substance that is made up of atoms with the same atomic number. A chemical element cannot be decomposed through chemical reactions"@en;
        skos:prefLabel    "Chemical element"@en .

sml-term:Gas  rdf:type    skos:Concept;
        rdfs:comment      "Matter in an intermediate state between liquid and plasma that can be contained only if it is fully surrounded by a solid (or in a bubble of liquid) (or held together by gravitational pull); it can condense into a liquid, or can (rarely) become a solid directly by deposition"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Gas"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:AggregationStateType;
        skos:definition   "Matter in an intermediate state between liquid and plasma that can be contained only if it is fully surrounded by a solid (or in a bubble of liquid) (or held together by gravitational pull); it can condense into a liquid, or can (rarely) become a solid directly by deposition"@en;
        skos:prefLabel    "Gas"@en .

sml:hasTemporalEntity
        rdf:type          rdf:Property , owl:ObjectProperty;
        rdfs:comment      "The abstract temporal entity representing a concrete concept in time"@en;
        rdfs:domain       sml:ConcreteConcept;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "has temporal entity"@en;
        rdfs:range        time:TemporalEntity;
        rdfs:seeAlso      sml-term:hasTemporalEntity;
        vs:term_status    "stable";
        skos:definition   "The abstract temporal entity representing a concrete concept in time"@en;
        skos:prefLabel    "has temporal entity"@en .

sml:FunctionalEntity  rdf:type  sh:NodeShape , owl:Class , rdfs:Class;
        rdfs:comment      "An entity involving the external behavior where the output contributes to stakeholder objectives implemented/played by one or more technical entities"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Functional entity"@en;
        rdfs:seeAlso      sml-term:FunctionalEntity;
        rdfs:subClassOf   sml:Entity;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sml:Entity;
                            owl:onProperty     sml:hasPart
                          ];
        vs:term_status    "stable";
        skos:definition   "An entity involving the external behavior where the output contributes to stakeholder objectives implemented/played by one or more technical entities"@en;
        skos:prefLabel    "Functional entity"@en;
        sh:property       [ sh:class  sml:TechnicalEntity;
                            sh:path   sml:hasSolution
                          ];
        sh:property       [ sh:class  sml:FunctionalEntity;
                            sh:path   sml:hasFunctionalPart
                          ];
        sh:property       [ sh:class  sml:Entity;
                            sh:path   sml:hasPart
                          ] .

sml-term:Liquid  rdf:type  skos:Concept;
        rdfs:comment      "A liquid is a nearly incompressible fluid that conforms to the shape of its container but retains a (nearly) constant volume independent of pressure"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Liquid"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:AggregationStateType;
        skos:definition   "A liquid is a nearly incompressible fluid that conforms to the shape of its container but retains a (nearly) constant volume independent of pressure"@en;
        skos:prefLabel    "Liquid"@en .

sml:ChemicalElement  rdf:type  owl:Class , rdfs:Class;
        rdfs:comment      "Pure substance that is made up of atoms with the same atomic number. A chemical element cannot be decomposed through chemical reactions"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Chemical element"@en;
        rdfs:seeAlso      sml-term:ChemicalElement;
        rdfs:subClassOf   sml:PureSubstance;
        vs:term_status    "stable";
        skos:definition   "Pure substance that is made up of atoms with the same atomic number. A chemical element cannot be decomposed through chemical reactions"@en;
        skos:prefLabel    "Chemical element"@en .

sml-term:PlannedEntity
        rdf:type          skos:Concept;
        rdfs:comment      "An entity that does not yet exist in physical reality, but which exists in mental or conceptual reality"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Planned entity"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:Entity;
        skos:definition   "An entity that does not yet exist in physical reality, but which exists in mental or conceptual reality"@en;
        skos:prefLabel    "Planned entity"@en .

sml-term:isRealizedBy
        rdf:type          skos:Concept;
        rdfs:comment      "The realized entity that realizes a planned entity"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "is realized by"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:isPlanFor;
        skos:definition   "The realized entity that realizes a planned entity"@en;
        skos:prefLabel    "is realized by"@en .

sml-term:EnergyFlow  rdf:type  skos:Concept;
        rdfs:comment      "The movement of an amount of energy (as capacity to do work)"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Energy flow"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:TransferType;
        skos:definition   "The movement of an amount of energy (as capacity to do work)"@en;
        skos:prefLabel    "Energy flow"@en .

sml:QuantityValue  rdf:type  sh:NodeShape , rdfs:Class , owl:Class;
        rdfs:comment      "The objectification of a value of a quantity (typically involving a quantity kind and a unit) having a complex value like a simple value sec combined with other metadata or just a combination of simple values"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Quantity value"@en;
        rdfs:seeAlso      sml-term:QuantityValue;
        rdfs:subClassOf   sml:Objectification;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type     owl:Class;
                                                 owl:unionOf  ( xsd:decimal xsd:float xsd:double xsd:integer )
                                               ];
                            owl:onProperty     rdf:value
                          ];
        vs:term_status    "stable";
        skos:definition   "The objectification of a value of a quantity (typically involving a quantity kind and a unit) having a complex value like a simple value sec combined with other metadata or just a combination of simple values"@en;
        skos:prefLabel    "Quantity value"@en;
        sh:property       [ sh:or    ( [ sh:datatype  xsd:decimal ]
                                       [ sh:datatype  xsd:float ]
                                       [ sh:datatype  xsd:double ]
                                     );
                            sh:path  rdf:value
                          ] .

sml:Matter  rdf:type      sh:NodeShape , owl:Class , rdfs:Class;
        rdfs:comment      "A pure chemical substance, chemical compound or mixture from which real objects are made"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Matter"@en;
        rdfs:seeAlso      sml-term:Matter;
        rdfs:subClassOf   sml:PhysicalObject;
        vs:term_status    "stable";
        skos:definition   "A pure chemical substance, chemical compound or mixture from which real objects are made"@en;
        skos:prefLabel    "Matter"@en;
        sh:property       [ sh:class  sml:AggregationStateType;
                            sh:path   sml:aggregationStateType
                          ];
        sh:property       [ sh:datatype  xsd:string;
                            sh:path      sml:chemicalFormula
                          ] .

sml:isRealizedBy  rdf:type  rdf:Property , owl:ObjectProperty;
        rdfs:comment        "The realized entity that realizes a planned entity"@en;
        rdfs:domain         sml:PlannedEntity;
        rdfs:isDefinedBy    <https://w3id.org/sml/>;
        rdfs:label          "is realized by"@en;
        rdfs:range          sml:RealizedEntity;
        rdfs:seeAlso        sml-term:isRealizedBy;
        rdfs:subPropertyOf  sml:isPlanFor;
        vs:term_status      "stable";
        skos:definition     "The realized entity that realizes a planned entity"@en;
        skos:prefLabel      "is realized by"@en .

sml-term:HeterogeneousMixture
        rdf:type          skos:Concept;
        rdfs:comment      "A mixture that is separated into different regions or phases that have different compositions or properties"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Heterogeneous mixture"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:Mixture;
        skos:definition   "A mixture that is separated into different regions or phases that have different compositions or properties"@en;
        skos:prefLabel    "Heterogeneous mixture"@en .

sml-term:Object  rdf:type  skos:Concept;
        rdfs:comment      "Entity that exists or can exist within a concrete space-time. An object executes an activity, and is transformed by an activity"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Object"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:Entity;
        skos:definition   "Entity that exists or can exist within a concrete space-time. An object executes an activity, and is transformed by an activity"@en;
        skos:prefLabel    "Object"@en .

sml:abbreviation  rdf:type  owl:AnnotationProperty , rdf:Property;
        rdfs:comment        "Acronym or initial word as special case of an external name"@en;
        rdfs:domain         sml:TopConcept;
        rdfs:isDefinedBy    <https://w3id.org/sml/>;
        rdfs:label          "abbreviation"@en;
        rdfs:range          xsd:string;
        rdfs:seeAlso        sml-term:abbreviation;
        rdfs:subPropertyOf  skos:altLabel;
        vs:term_status      "stable";
        skos:definition     "Acronym or initial word as special case of an external name"@en;
        skos:prefLabel      "abbreviation"@en .

sml-term:overInterface
        rdf:type          skos:Concept;
        rdfs:comment      "The interface over which an interaction between physical objects takes place"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "over interface"@en;
        vs:term_status    "stable";
        skos:definition   "The interface over which an interaction between physical objects takes place"@en;
        skos:prefLabel    "over interface"@en .

sml-term:TopConcept  rdf:type  skos:Concept;
        rdfs:comment      "The most generic concept"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Top concept"@en;
        vs:term_status    "stable";
        skos:definition   "The most generic concept"@en;
        skos:prefLabel    "Top concept"@en .

sml:Force  rdf:type       sml:TransferType;
        rdfs:comment      "Physical quantity which, when exerted on a body, causes tension or pressure to arise therein, or which causes the body to change motion, accelerate"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Force"@en;
        rdfs:seeAlso      sml-term:Force;
        vs:term_status    "stable";
        skos:definition   "Physical quantity which, when exerted on a body, causes tension or pressure to arise therein, or which causes the body to change motion, accelerate"@en;
        skos:prefLabel    "Force"@en .

sml-term:Unit  rdf:type   skos:Concept;
        rdfs:comment      "A particular quantity value that has been chosen as a scale for measuring other quantities the same kind"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Unit"@en;
        vs:term_status    "stable";
        skos:definition   "A particular quantity value that has been chosen as a scale for measuring other quantities the same kind"@en;
        skos:prefLabel    "Unit"@en .

sml-term:hasBoundary  rdf:type  skos:Concept;
        rdfs:comment      "The geometric entity representing the boundary of a concrete concept"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "has boundary"@en;
        vs:term_status    "stable";
        skos:definition   "The geometric entity representing the boundary of a concrete concept"@en;
        skos:prefLabel    "has boundary"@en .

sml:PlannedEntity  rdf:type  rdfs:Class , owl:Class , sh:NodeShape;
        rdfs:comment      "An entity that does not yet exist in physical reality, but which exists in mental or conceptual reality"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Planned entity"@en;
        rdfs:seeAlso      sml-term:PlannedEntity;
        rdfs:subClassOf   sml:Entity;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  sml:PlannedEntity;
                            owl:onProperty     sml:hasPart
                          ];
        vs:term_status    "stable";
        skos:definition   "An entity that does not yet exist in physical reality, but which exists in mental or conceptual reality"@en;
        skos:prefLabel    "Planned entity"@en;
        sh:property       [ sh:class  sml:PlannedEntity;
                            sh:path   sml:hasPart
                          ];
        sh:property       [ sh:class  sml:RealizedEntity;
                            sh:path   sml:isPlanFor
                          ] .

sml:RequirementSourceType
        rdf:type          sml:EnumerationType , rdfs:Class , owl:Class;
        rdfs:comment      "The type of source from which a requirement comes like a client, by definition, recommended by the sector or demanded by law/regulation"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Requirement source type"@en;
        rdfs:seeAlso      sml-term:RequirementSourceType;
        vs:term_status    "stable";
        skos:definition   "The type of source from which a requirement comes like a client, by definition, recommended by the sector or demanded by law/regulation"@en;
        skos:prefLabel    "Requirement source type"@en .

sml:Plasma  rdf:type      sml:AggregationStateType;
        rdfs:comment      "A phase in which the particles of a gaseous substance are ionised"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Plasma"@en;
        rdfs:seeAlso      sml-term:Plasma;
        vs:term_status    "stable";
        skos:definition   "A phase in which the particles of a gaseous substance are ionised"@en;
        skos:prefLabel    "Plasma"@en .

sml-term:RelationReference
        rdf:type          skos:Concept;
        rdfs:comment      "The objectification of a reference for a relation having a complex value like a simple reference sec combined with other metadata or just a combination of simple references (n-ary relation)"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Relation reference"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:Objectification;
        skos:definition   "The objectification of a reference for a relation having a complex value like a simple reference sec combined with other metadata or just a combination of simple references (n-ary relation)"@en;
        skos:prefLabel    "Relation reference"@en .

sml:AllDisjointClassesShape
        rdf:type             sh:NodeShape;
        rdfs:isDefinedBy     <https://w3id.org/sml/>;
        vs:term_status       "stable";
        sh:property          [ sh:path                 ( rdf:type
                                                         [ sh:zeroOrMorePath  rdfs:subClassOf ]
                                                       );
                               sh:qualifiedMaxCount    1;
                               sh:qualifiedValueShape  [ sh:in   ( sml:PlannedEntity sml:RealizedEntity )
                                                       ]
                             ];
        sh:property          [ sh:path                 ( rdf:type
                                                         [ sh:zeroOrMorePath  rdfs:subClassOf ]
                                                       );
                               sh:qualifiedMaxCount    1;
                               sh:qualifiedValueShape  [ sh:in   ( sml:FunctionalEntity sml:TechnicalEntity )
                                                       ]
                             ];
        sh:property          [ sh:path                 ( rdf:type
                                                         [ sh:zeroOrMorePath  rdfs:subClassOf ]
                                                       );
                               sh:qualifiedMaxCount    1;
                               sh:qualifiedValueShape  [ sh:in   ( sml:PhysicalObject sml:InformationObject sml:State sml:Event sml:Activity )
                                                       ]
                             ];
        sh:targetSubjectsOf  rdf:type .

sml:RealizedEntity  rdf:type  rdfs:Class , owl:Class , sh:NodeShape;
