        rdfs:label        "transforms"@en;
        rdfs:range        sml:Object;
        rdfs:seeAlso      sml-term:transforms;
        vs:term_status    "stable";
        skos:definition   "The object transformed by an activity"@en;
        skos:prefLabel    "transforms"@en .

sml:Gas  rdf:type         sml:AggregationStateType;
        rdfs:comment      "Matter in an intermediate state between liquid and plasma that can be contained only if it is fully surrounded by a solid (or in a bubble of liquid) (or held together by gravitational pull); it can condense into a liquid, or can (rarely) become a solid directly by deposition"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Gas"@en;
        rdfs:seeAlso      sml-term:Gas;
        vs:term_status    "stable";
        skos:definition   "Matter in an intermediate state between liquid and plasma that can be contained only if it is fully surrounded by a solid (or in a bubble of liquid) (or held together by gravitational pull); it can condense into a liquid, or can (rarely) become a solid directly by deposition"@en;
        skos:prefLabel    "Gas"@en .

sml:aggregationStateType
        rdf:type          rdf:Property , owl:ObjectProperty;
        rdfs:comment      "The possession of an aggregation state type"@en;
        rdfs:domain       sml:Matter;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "aggregation state type"@en;
        rdfs:range        sml:AggregationStateType;
        rdfs:seeAlso      sml-term:aggregationStateType;
        vs:term_status    "stable";
        skos:definition   "The possession of an aggregation state type"@en;
        skos:prefLabel    "aggregation state type"@en .

sml-term:hasState  rdf:type  skos:Concept;
        rdfs:comment      "The state of an entity in a certain point or period of time"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "has state"@en;
        vs:term_status    "stable";
        skos:definition   "The state of an entity in a certain point or period of time"@en;
        skos:prefLabel    "has state"@en .

sml:Interface  rdf:type   sh:NodeShape , owl:Class , rdfs:Class;
        rdfs:comment      "A spatial object, typically a thin 2D physical space (but also 0D or 1D) that connects two physical objects or ports of physical objects through which a static or dynamic interaction or interaction between those elements can take place"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Interface"@en;
        rdfs:seeAlso      sml-term:Interface;
        rdfs:subClassOf   sml:SpatialRegion;
        vs:term_status    "stable";
        skos:definition   "A spatial object, typically a thin 2D physical space (but also 0D or 1D) that connects two physical objects or ports of physical objects through which a static or dynamic interaction or interaction between those elements can take place"@en;
        skos:prefLabel    "Interface"@en;
        sh:property       [ sh:class  sml:PhysicalObject;
                            sh:path   sml:connectsObject
                          ];
        sh:property       [ sh:class  sml:Port;
                            sh:path   sml:connectsPort
                          ] .

sml:SpatialRegion  rdf:type  owl:Class , sh:NodeShape , rdfs:Class;
        rdfs:comment      "A physical object that encloses a particular area such as a room, roadway and river, that is bounded by real objects or other spatial areas (e.g., by usage or convention) and that contains primarily liquid or gaseous amount of matter"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Spatial region"@en;
        rdfs:seeAlso      sml-term:SpatialRegion;
        rdfs:subClassOf   sml:PhysicalObject;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type     owl:Class;
                                                 owl:unionOf  ( sml:SpatialRegion sml:Port )
                                               ];
                            owl:onProperty     sml:hasPart
                          ];
        vs:term_status    "stable";
        skos:definition   "A physical object that encloses a particular area such as a room, roadway and river, that is bounded by real objects or other spatial areas (e.g., by usage or convention) and that contains primarily liquid or gaseous amount of matter"@en;
        skos:prefLabel    "Spatial region"@en;
        sh:property       [ sh:class  sml:PhysicalObject;
                            sh:path   sml:isBoundBy
                          ];
        sh:property       [ sh:class  sml:RealObject;
                            sh:path   sml:contains
                          ];
        sh:property       [ sh:or    ( [ sh:class  sml:SpatialRegion ]
                                       [ sh:class  sml:Port ]
                                     );
                            sh:path  sml:hasPart
                          ] .

sml-term:Port  rdf:type   skos:Concept;
        rdfs:comment      "A physical or logical point of interaction as part of a physical object where, through a connection or interface, an interaction can take place"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Port"@en;
        vs:term_status    "stable";
        skos:broader      sml-term:PhysicalObject;
        skos:definition   "A physical or logical point of interaction as part of a physical object where, through a connection or interface, an interaction can take place"@en;
        skos:prefLabel    "Port"@en .

sml-term:hasUnit  rdf:type  skos:Concept;
        rdfs:comment      "The possession of a unit"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "has unit"@en;
        vs:term_status    "stable";
        skos:definition   "The possession of a unit"@en;
        skos:prefLabel    "has unit"@en .

sml:isPlanFor  rdf:type   rdf:Property , owl:ObjectProperty;
        rdfs:comment      "A potentially realized entity according to this planned entity"@en;
        rdfs:domain       sml:PlannedEntity;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "is plan for"@en;
        rdfs:range        sml:RealizedEntity;
        rdfs:seeAlso      sml-term:isPlanFor;
        vs:term_status    "stable";
        skos:definition   "A potentially realized entity according to this planned entity"@en;
        skos:prefLabel    "is plan for"@en .

sml:Port  rdf:type        rdfs:Class , owl:Class;
        rdfs:comment      "A physical or logical point of interaction as part of a physical object where, through a connection or interface, an interaction can take place"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Port"@en;
        rdfs:seeAlso      sml-term:Port;
        rdfs:subClassOf   sml:PhysicalObject;
        vs:term_status    "stable";
        skos:definition   "A physical or logical point of interaction as part of a physical object where, through a connection or interface, an interaction can take place"@en;
        skos:prefLabel    "Port"@en .

<https://www.cencenelec.eu.nl>
        rdf:type    foaf:Organization;
        rdfs:label  "European Committee for Standardization"@nl .

sml:RealObject  rdf:type  owl:Class , rdfs:Class , sh:NodeShape;
        rdfs:comment      "physical object (rigid or non-rigid) that is (or can be) tangible and visible in reality, man-made or naturally occurring"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Real object"@en;
        rdfs:seeAlso      sml-term:RealObject;
        rdfs:subClassOf   sml:PhysicalObject;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type     owl:Class;
                                                 owl:unionOf  ( sml:RealObject sml:Port )
                                               ];
                            owl:onProperty     sml:hasPart
                          ];
        vs:term_status    "stable";
        skos:definition   "physical object (rigid or non-rigid) that is (or can be) tangible and visible in reality, man-made or naturally occurring"@en;
        skos:prefLabel    "Real object"@en;
        sh:property       [ sh:or    ( [ sh:class  sml:Matter ]
                                       [ sh:class  sml:MatterPortion ]
                                     );
                            sh:path  sml:consistsOf
                          ];
        sh:property       [ sh:or    ( [ sh:class  sml:RealObject ]
                                       [ sh:class  sml:Port ]
                                     );
                            sh:path  sml:hasPart
                          ] .

sml:TransferType  rdf:type  sml:EnumerationType , owl:Class , rdfs:Class , sh:NodeShape;
        rdfs:comment      "The type of thing being transferred, here: material, information, energy or force"@en;
        rdfs:isDefinedBy  <https://w3id.org/sml/>;
        rdfs:label        "Transfer type"@en;
        rdfs:seeAlso      sml-term:TransferType;
        owl:oneOf         ( sml:MaterialFlow sml:EnergyFlow sml:InformationFlow sml:Force );
        vs:term_status    "stable";
        skos:definition   "The type of thing being transferred, here: material, information, energy or force"@en;
        skos:prefLabel    "Transfer type"@en;
        sh:in             ( sml:MaterialFlow sml:EnergyFlow sml:InformationFlow sml:Force ) .

sml:InformationObject
        rdf:type          owl:Class , rdfs:Class;
        rdfs:comment      "Object which describes a thing in reality"@en;
